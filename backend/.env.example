# Port Express listens on (Render automatically provides process.env.PORT)
PORT=5001

# Supabase Transaction Pooler connection string (Port 6543) used by Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct connection string (Port 5432) used for Prisma migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Hostinger frontend URL (comma-separated if multiple origins)
FRONTEND_URL="https://your-hostinger-domain.com"

# Secret key required to access GET /api/leads (Optional)
ADMIN_API_KEY=""
